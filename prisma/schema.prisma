// 셔틀이 도메인 스키마.
// 실시간 GPS 추적이 핵심이라 LocationPing이 처음부터 들어간다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// === 테넌트 ===
model Organization {
  id            String    @id @default(cuid())
  name          String
  type          OrgType   @default(ACADEMY)
  plan          Plan      @default(TRIAL)
  // W24: 운영 상태. 셔틀이 매니저(어드민)가 일시정지·트라이얼 만료 표시 가능.
  // SUSPENDED·TRIAL_EXPIRED 시 학원장·기사·동승자 로그인 차단 (학부모는 자녀의
  // 다른 학원이 ACTIVE면 통과). 진행 중 trip은 안전상 강제 종료 안 함.
  status        OrgStatus @default(ACTIVE)
  activatedAt   DateTime?
  suspendedAt   DateTime?
  suspendReason String?
  createdAt     DateTime  @default(now())

  vehicles                 Vehicle[]
  students                 Student[]
  staffs                   Staff[]
  stops                    Stop[]
  invites                  StaffInvite[]
  guardianInvites          GuardianInvite[]
  stopChangeRequests       StopChangeRequest[]
  // W24-B: 정류장 변경 정책·ledger·assignment 신규
  routeAssignments         RouteAssignment[]
  routeAssignmentOverrides RouteAssignmentOverride[]
  stopChangeLedger         StopChangeLedger[]
  policy                   TenantPolicy?
  // W24-C: 결제·구독
  subscription             TenantSubscription?
  invoices                 Invoice[]
}

// 기사·동승자 초대 토큰 (1회용).
// OWNER가 미리 이름·전화·역할을 적어 토큰을 발급하면, 받은 사람이
// /invite/<token> 링크로 들어가 본인 이메일·비밀번호를 정해 가입한다.
// 가입이 끝나면 acceptedAt이 채워지고 동일 토큰으로 재가입 불가.
model StaffInvite {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  role              StaffRole // OWNER 발급 거절 (server action에서 검증)
  name              String
  phone             String
  loginId           String? // 발급 시 학원장이 정한 로그인 아이디. 본인이 그대로 사용.
  token             String       @unique
  createdAt         DateTime     @default(now())
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedByStaffId String?

  @@index([orgId])
}

// 학부모(보호자) 초대 토큰 (1회용).
// OWNER가 학생 1명 이상 + 보호자 정보(name·phone·relation·isPrimary)와 함께 발급.
// 받은 사람이 /parent-invite/<token>로 들어가 본인 이메일·비밀번호를 정해 가입한다.
// 가입 시 phone unique로 Guardian upsert + GuardianLink N건 생성.
model GuardianInvite {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id])
  name                 String
  phone                String
  relation             String // "모", "부", "조부" 등
  isPrimary            Boolean      @default(false)
  loginId              String? // 발급 시 학원장이 정한 로그인 아이디. 본인이 그대로 사용.
  token                String       @unique
  createdAt            DateTime     @default(now())
  expiresAt            DateTime
  acceptedAt           DateTime?
  acceptedByGuardianId String?

  students GuardianInviteStudent[]

  @@index([orgId])
}

// invite ↔ student N:M (한 초대로 자녀 여러 명 묶기)
model GuardianInviteStudent {
  id        String         @id @default(cuid())
  inviteId  String
  invite    GuardianInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  studentId String
  student   Student        @relation(fields: [studentId], references: [id])

  @@unique([inviteId, studentId])
}

enum OrgType {
  ACADEMY // 학원·교습소
  DAYCARE // 어린이집
  KINDERGARTEN // 유치원
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

// W24: 학원 운영 상태. SUSPENDED/TRIAL_EXPIRED는 매니저가 일시정지 시킨 학원.
enum OrgStatus {
  ACTIVE
  SUSPENDED
  TRIAL_EXPIRED
}

// === 차량·운영자 ===
model Vehicle {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  plate          String // 차량번호
  mode           VehicleMode  @default(GENERAL)
  // KIDS 모드 전용 필드 (nullable)
  reportNo       String? // 어린이통학버스 신고증명서 번호
  insuranceUntil DateTime? // 보험 만료일

  routes Route[]
  trips  Trip[]

  @@index([orgId])
}

enum VehicleMode {
  KIDS
  GENERAL
}

model Staff {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  userId        String? // Supabase auth.users 연결
  loginId       String?      @unique // 영문·숫자·_ 4~20자. 학원장 발급 또는 본인 선택. 이메일 대신 사용.
  recoveryEmail String? // 비밀번호 찾기용 이메일. 입력 시 Auth user.email = 이 값. 미입력 시 placeholder.
  name          String
  phone         String
  role          StaffRole

  trainings         TrainingRecord[]
  driverTrips       Trip[]                  @relation("DriverTrips")
  helperTrips       Trip[]                  @relation("HelperTrips")
  pushSubscriptions StaffPushSubscription[]
  fcmSubscriptions  StaffFcmSubscription[]

  @@index([orgId])
  @@index([userId])
}

enum StaffRole {
  OWNER
  DRIVER
  HELPER
}

// 안전교육 이수 기록 (운영자·운전자·동승자 2년마다)
model TrainingRecord {
  id              String           @id @default(cuid())
  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id])
  category        TrainingCategory
  completedOn     DateTime
  expiresOn       DateTime // completedOn + 2년 (해당 연도 12/31)
  certificateUrl  String? // 외부 URL (선택)
  certificateFile String? // Supabase Storage object key, e.g. "{orgId}/{recordId}/{uuid}.pdf"
}

enum TrainingCategory {
  OPERATOR
  DRIVER
  HELPER
}

// === 노선·정류장 ===
model Route {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  name      String // "월수금 등원 1코스"
  direction RouteDirection
  weekdays  Int // 비트마스크: 월=1 화=2 수=4 목=8 금=16 토=32 일=64
  // W26-B: 노선 사용/미사용 토글. 미사용은 오늘 운행 후보·KPI에서 제외.
  // RouteStudent 매핑은 유지되어 활성화 시 즉시 복귀 가능 (시즌·방학중 전환).
  isActive  Boolean        @default(true)

  stops       RouteStop[]
  students    RouteStudent[]
  trips       Trip[]
  // W24-B: 임시·영구 정류장 매핑 (RouteStudent 보완)
  assignments RouteAssignment[]

  @@index([vehicleId])
  @@index([isActive])
}

enum RouteDirection {
  PICKUP // 등원
  DROPOFF // 하원
}

model Stop {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  name    String // "○○아파트 정문"
  lat     Float
  lng     Float
  // 카카오 reverse geocoding으로 등록·수정 시점에 같이 저장한 도로명 또는 지번 주소.
  // 사용자 노출은 좌표 대신 이 값. nullable — 등록 후 카카오 일시 장애·외국 좌표 등.
  address String?
  radiusM Int          @default(50) // 도착 판정 반경 (미터)
  // W26-E: 정류장 사용/미사용 토글. 미사용은 신규 노선·학생 배정 picker에서 제외.
  // 기존 RouteStop·RouteStudent는 그대로 유지되어 재활성화 시 즉시 복귀 가능
  // (계절·임시 폐쇄·터널 공사 등 운영 시나리오).
  isActive Boolean @default(true)

  routes                  RouteStop[]
  students                RouteStudent[]
  changeRequestsFrom      StopChangeRequest[]       @relation("StopChangeFrom")
  changeRequestsResult    StopChangeRequest[]       @relation("StopChangeResult")
  changeRequestsRequested StopChangeRequest[]       @relation("StopChangeRequested")
  // W24-B: stop-change ledger·override
  assignmentsCurrent      RouteAssignment[]         @relation("AssignmentCurrentStop")
  overrides               RouteAssignmentOverride[]
  ledgerFrom              StopChangeLedger[]        @relation("LedgerFromStop")
  ledgerTo                StopChangeLedger[]        @relation("LedgerToStop")

  @@index([orgId])
  @@index([orgId, isActive])
}

model RouteStop {
  id          String @id @default(cuid())
  routeId     String
  route       Route  @relation(fields: [routeId], references: [id])
  stopId      String
  stop        Stop   @relation(fields: [stopId], references: [id])
  order       Int // 순서
  scheduledAt String // "HH:mm" 형식 예정 시각

  @@unique([routeId, order])
}

// === 학생·보호자 ===
model Student {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String
  birthYear Int // KIDS 모드 자동 판정용
  // W23+: 학교 (선택). 일괄 등록·정류장 그룹·학원장 학생 list 검색용.
  // 외부 시스템 export(예: "달성초")는 normalize 거쳐 "달성초등학교" 형태로 저장.
  school    String?

  guardians          GuardianLink[]
  routes             RouteStudent[]
  events             BoardingEvent[]
  absences           AbsenceRequest[]
  guardianInvites    GuardianInviteStudent[]
  stopChangeRequests StopChangeRequest[]
  // W24-B
  assignments        RouteAssignment[]
  ledgerEntries      StopChangeLedger[]

  @@index([orgId])
}

model Guardian {
  id            String  @id @default(cuid())
  userId        String? // Supabase auth (학부모 본인 계정)
  loginId       String? @unique // 영문·숫자·_ 4~20자. 학원장 발급 또는 본인 선택. 이메일 대신 사용.
  recoveryEmail String? // 비밀번호 찾기용 이메일. 입력 시 Auth user.email = 이 값.
  name          String
  phone         String  @unique

  links              GuardianLink[]
  absences           AbsenceRequest[]
  pushSubscriptions  PushSubscription[]
  stopChangeRequests StopChangeRequest[]

  @@index([userId])
}

model GuardianLink {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  relation   String // "모", "부", "조부" 등
  isPrimary  Boolean  @default(false)

  @@unique([studentId, guardianId])
}

model RouteStudent {
  id        String  @id @default(cuid())
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  stopId    String // 이 학생이 타고 내리는 정류장
  stop      Stop    @relation(fields: [stopId], references: [id])

  @@unique([routeId, studentId])
  @@index([studentId])
}

// === 일별 운행 ===
model Trip {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  routeId   String
  route     Route     @relation(fields: [routeId], references: [id])
  driverId  String
  driver    Staff     @relation("DriverTrips", fields: [driverId], references: [id])
  helperId  String?
  helper    Staff?    @relation("HelperTrips", fields: [helperId], references: [id])
  date      DateTime  @db.Date
  startedAt DateTime?
  endedAt   DateTime?

  // 운행 시작·종료 위치 (요약용, 상세 트랙은 LocationPing)
  startLat Float?
  startLng Float?
  endLat   Float?
  endLng   Float?

  events      BoardingEvent[]
  safetyCheck SafetyCheck?
  pings       LocationPing[]

  @@unique([vehicleId, routeId, date])
  @@index([driverId, date])
}

model BoardingEvent {
  id        String       @id @default(cuid())
  tripId    String
  trip      Trip         @relation(fields: [tripId], references: [id])
  studentId String
  student   Student      @relation(fields: [studentId], references: [id])
  type      BoardingType
  at        DateTime     @default(now())
  lat       Float?
  lng       Float?
  notes     String?

  @@index([tripId, type])
}

enum BoardingType {
  BOARD
  ALIGHT
  NO_SHOW // 미탑승 (등원 정류장에 안 옴)
  NO_DROPOFF // 미하차 (하원 정류장에서 못 내림)
}

// 운행 중 위치 ping (영구 저장, 면책 자료)
// 영구 저장 정책: 30초 간격 + 정류장 통과 시점 + 시작/종료
// (실시간 broadcast는 DB 거치지 않고 Supabase Realtime broadcast 채널 사용)
model LocationPing {
  id         String     @id @default(cuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id])
  lat        Float
  lng        Float
  accuracy   Float? // GPS 정확도 (미터)
  speed      Float? // 속도 (m/s)
  heading    Float? // 진행 방향 0~360
  recordedAt DateTime   @default(now())
  source     PingSource @default(INTERVAL)

  @@index([tripId, recordedAt])
}

enum PingSource {
  INTERVAL // 30초 간격 자동
  STOP_PASS // 정류장 반경 진입 (자동 판정)
  START // 운행 시작 시점
  END // 운행 종료 시점
}

// KIDS 모드: 매 운행 안전점검 (도로교통법 §53⑦ 안전운행기록 원천 데이터)
model SafetyCheck {
  id                String    @id @default(cuid())
  tripId            String    @unique
  trip              Trip      @relation(fields: [tripId], references: [id])
  seatbeltAllOk     Boolean // 출발 전 전원 안전띠 확인
  seatbeltCheckedAt DateTime?
  helperPresent     Boolean // 동승보호자 동승 확인
  allAlightedOk     Boolean // 운행 종료 후 전원 하차 확인
  alightCheckedAt   DateTime?
  // W26-A: refac Driver Run.html 9 항목 영구 저장 (도교법 §53)
  emergencyLightOk  Boolean   @default(false) // pre: 비상등·후진경보음 작동
  doorLockOk        Boolean   @default(false) // pre: 출입문 잠금장치 정상
  capacityOk        Boolean   @default(false) // pre: 좌석·통로 인원 제한 충족
  cabinLockOk       Boolean   @default(false) // post: 차량 내부 잠금
  keyReturnedOk     Boolean   @default(false) // post: 시동키 회수
  recordReviewedOk  Boolean   @default(false) // post: 운영기록 검토
}

// 결석·일시 불승차 신청
model AbsenceRequest {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  date           DateTime      @db.Date
  type           AbsenceType
  reason         String?
  status         AbsenceStatus @default(PENDING)
  createdBy      String // guardianId
  guardian       Guardian      @relation(fields: [createdBy], references: [id])
  createdAt      DateTime      @default(now())
  // W10 보강 — OWNER 결정 트래킹
  decidedBy      String? // staffId (OWNER)
  decidedAt      DateTime?
  rejectReason   String? // status REJECTED일 때만
  // W24-B: 승인/반려 시 결정 메모 (rejectReason과 별도 — 자동 처리·정책 기록 등 일반 메모)
  decisionReason String?

  @@index([studentId, date])
  @@index([createdBy])
}

enum AbsenceType {
  ABSENT_BOTH
  ABSENT_PICKUP
  ABSENT_DROPOFF
}

enum AbsenceStatus {
  PENDING
  NOTIFIED_DRIVER
  ACKNOWLEDGED
  REJECTED
}

// 학부모 브라우저 push 구독 정보. W6 web-push 발송 대상.
model PushSubscription {
  id         String   @id @default(cuid())
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([guardianId])
}

// OWNER(향후 driver/helper로 확장 가능) 브라우저 push 구독 정보.
// Staff와 Guardian은 별도 모델 — 같은 endpoint를 둘 다 가질 일 없고 구독·해제
// 흐름이 명확해짐. (CLAUDE.md 멀티테넌시: orgId는 Staff에 이미 있으니 별도 컬럼 X)
model StaffPushSubscription {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([staffId])
}

// W23: 기사용 RN 앱(안드로이드 사이드로드 APK) FCM 토큰.
// StaffPushSubscription(Web Push)과 별도 테이블 — 같은 기사가 PWA와 RN 앱을
// 동시에 쓸 수 있고, web-push와 firebase-admin SDK는 페이로드 형식이 달라
// 한 테이블로 합치면 if-else가 sendToStaff 호출처마다 들어감. fan-out은
// src/lib/push/server.ts에서 양쪽 테이블 각각 조회 후 병렬 발송.
model StaffFcmSubscription {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fcmToken   String   @unique
  platform   String // "android" | "ios" — 베타는 android만
  appVersion String? // 강제 업데이트 판정·디버깅용
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([staffId])
}

// W8: 마케팅 랜딩 사전등록. 베타 런칭 전에 관심 학원·기관 모음.
// orgType은 ACADEMY/DAYCARE/KINDERGARTEN. 한 이메일·전화 1회만.
model PreRegistration {
  id        String   @id @default(cuid())
  orgName   String
  orgType   OrgType
  contact   String // 담당자 이름
  email     String   @unique
  phone     String
  region    String? // "서울 강남구" 등 자유 입력
  notes     String? // 자유 메모
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// W10: 인앱 알림 미러. Web Push와 별개로 항상 DB에 행 생성
// (푸시 권한 없거나 발송 실패해도 인앱 list에서 확인 가능).
// userId는 Supabase auth.users id. Guardian/Staff 누구나 수신 가능.
model Notification {
  id        String               @id @default(cuid())
  userId    String // auth.users.id
  category  NotificationCategory
  title     String
  body      String
  payload   Json?
  url       String? // 클릭 시 이동 경로
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationCategory {
  TRIP_STARTED
  STUDENT_BOARDED
  STUDENT_DROPPED_OFF
  STUDENT_NO_SHOW
  STUDENT_NO_DROPOFF
  TRIP_DELAYED
  TRIP_ENDED
  ABSENCE_REQUESTED // OWNER에게: 새 결석 신청
  ABSENCE_APPROVED
  ABSENCE_REJECTED
  STOP_CHANGE_REQUESTED // OWNER에게: 새 정류장 변경 요청
  STOP_CHANGE_APPROVED
  STOP_CHANGE_REJECTED
  ANNOUNCEMENT
  EMERGENCY
  SHUTTLE_NEAR_CHILD // W17-E: 셔틀이 자녀 정류장에 도착·근접 (driver STOP_PASS ping에서 fan-out)
}

// W10: 정류장 변경 요청. 학부모가 새 위치를 카카오맵 picker로 선택 →
// OWNER 승인 시 자녀의 RouteStudent.stopId 갱신 (effectiveAt 이후 trip부터).
// Stop은 새로 만들지 않고 기존 stop 매핑 또는 신규 stop 별도 생성하는 흐름은
// 1차 단순화 — OWNER가 승인 시 toLat/toLng로 새 Stop 만들어 매핑.
model StopChangeRequest {
  id              String        @id @default(cuid())
  orgId           String
  org             Organization  @relation(fields: [orgId], references: [id])
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  fromStopId      String
  fromStop        Stop          @relation("StopChangeFrom", fields: [fromStopId], references: [id])
  toLat           Float
  toLng           Float
  toAddress       String? // 역지오코딩 결과 (선택)
  // W24-B: 학부모 picker로 같은 노선의 기존 stop을 선택한 경우 채움.
  // 이 값이 있으면 학원장 승인 시 새 Stop 생성 없이 그 stopId를 resultStopId로 매핑.
  // null이면 legacy 자유 좌표 신청 — 기존 흐름(newStopName 입력 + Stop 생성).
  requestedStopId String?
  requestedStop   Stop?         @relation("StopChangeRequested", fields: [requestedStopId], references: [id])
  reason          String?
  effectiveAt     DateTime      @db.Date
  status          RequestStatus @default(PENDING)
  createdBy       String // guardianId
  guardian        Guardian      @relation(fields: [createdBy], references: [id])
  createdAt       DateTime      @default(now())

  // OWNER 결정 트래킹
  decidedBy      String? // staffId
  decidedAt      DateTime?
  rejectReason   String?
  decisionReason String? // W24-B: 승인 시 결정 메모(자동 승인·정책 기록 등)
  resultStopId   String? // 승인 시 매핑·생성된 새 Stop.id
  resultStop     Stop?                     @relation("StopChangeResult", fields: [resultStopId], references: [id])
  // W24-B: 이 요청에서 파생된 ledger·override
  ledgerEntries  StopChangeLedger[]
  overrides      RouteAssignmentOverride[]

  @@index([orgId, status])
  @@index([studentId])
  @@index([createdBy])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// === W24: 셔틀이 플랫폼 매니저(어드민) ===

// 매니저가 수행한 민감 작업 추적. impersonation 시작/종료, 비번 reset 대행,
// 학원 일시정지·plan 변경 등 모두 한 row씩. 베타 단계는 service_role로
// 매니저 본인이 삭제 가능하지만 수용 (베타 후 immutable storage 검토).
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorEmail   String // ENV 화이트리스트의 이메일
  action       String // "ORG_PLAN_CHANGED" / "IMPERSONATE_START" 등
  targetOrgId  String?
  targetUserId String? // auth.users.id
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([targetOrgId, createdAt])
}

// 기사 RN 앱 APK 버전 관리. 한 row만 isActive=true 유지하고 나머지는 history.
// /api/driver-app/version GET이 isActive row를 반환 → ENV fallback.
model DriverAppRelease {
  id            String   @id @default(cuid())
  version       String   @unique // semver, e.g. "1.0.1"
  apkUrl        String // EAS artifact URL 또는 GitHub Releases URL
  releaseNotes  String?
  sha256        String? // 64자 hex — 베타에서 무결성 확인용 (선택)
  fileSizeBytes Int? // 다운로드 안내·잘못된 파일 감지용 (선택)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([isActive, createdAt])
}

// === W24-B: 정류장 변경 ledger·정책 ===
//
// data/HANDOFF.md spec — 학부모·학원장이 신규 정류장을 만들 수 없게 하면서도
// "오늘만 다른 정류장" 임시 변경을 허용하기 위한 모델 4종.
//
// 동작:
// - 학생-노선-방향마다 RouteAssignment 1개 (currentStopId가 영구 효력 stop)
// - 임시 변경은 RouteAssignmentOverride (effectiveFrom~Until 기간)
// - 모든 결정은 StopChangeLedger에 기록 (감사 로그)
// - 학원별 운영 정책(자동 승인 등)은 TenantPolicy
//
// 기존 RouteStudent는 그대로 유지(legacy + 운행 생성 로직 호환). RouteAssignment는
// stop-change 흐름이 처음 학생을 만나면 lazy upsert로 RouteStudent에서 backfill.

model RouteAssignment {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id])
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id])
  routeId       String
  route         Route          @relation(fields: [routeId], references: [id])
  kind          RouteDirection // PICKUP | DROPOFF (기존 enum 재사용)
  currentStopId String
  currentStop   Stop           @relation("AssignmentCurrentStop", fields: [currentStopId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  overrides RouteAssignmentOverride[]

  @@unique([studentId, routeId, kind])
  @@index([orgId])
  @@index([routeId])
}

model RouteAssignmentOverride {
  id              String             @id @default(cuid())
  orgId           String
  org             Organization       @relation(fields: [orgId], references: [id])
  assignmentId    String
  assignment      RouteAssignment    @relation(fields: [assignmentId], references: [id])
  stopId          String
  stop            Stop               @relation(fields: [stopId], references: [id])
  effectiveFrom   DateTime           @db.Date
  effectiveUntil  DateTime           @db.Date
  sourceRequestId String?
  sourceRequest   StopChangeRequest? @relation(fields: [sourceRequestId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([orgId, assignmentId, effectiveFrom])
}

model StopChangeLedger {
  id          String            @id @default(cuid())
  orgId       String
  org         Organization      @relation(fields: [orgId], references: [id])
  requestId   String
  request     StopChangeRequest @relation(fields: [requestId], references: [id])
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id])
  fromStopId  String?
  fromStop    Stop?             @relation("LedgerFromStop", fields: [fromStopId], references: [id])
  toStopId    String
  toStop      Stop              @relation("LedgerToStop", fields: [toStopId], references: [id])
  appliedById String // staffId
  appliedAt   DateTime          @default(now())
  permanent   Boolean

  @@index([orgId, studentId])
  @@index([orgId, appliedAt])
}

model TenantPolicy {
  orgId                    String       @id
  org                      Organization @relation(fields: [orgId], references: [id])
  // 결석 정책
  absenceAutoAck           Boolean      @default(true) // 마감 전 결석은 자동 확인
  absenceCutoffMin         Int          @default(15) // 운행 시작 N분 전까지 자동 처리
  // 정류장 변경 정책
  stopChangeAutoApprove    Boolean      @default(false) // 인접 stop(±1) 자동 승인
  stopChangeRequiresReason Boolean      @default(false)
  stopChangeMaxDays        Int          @default(30)
  // 알림 정책
  notifyParentOnDecision   Boolean      @default(true)
  notifyDriverOnApprove    Boolean      @default(true)
  updatedAt                DateTime     @updatedAt
}

// === W24-C: 결제·구독 (UI/schema only) ===
//
// 결제 게이트웨이(Toss/Stripe) 통합은 별도 turn. 본 모델은 schema·UI만.
// Organization.plan은 그대로 두되(legacy 호환), TenantSubscription에 상태·주기·
// 다음 결제일 등 풍부한 정보 보관. /billing 페이지가 이 모델을 source로 사용.

model TenantSubscription {
  orgId                  String             @id
  org                    Organization       @relation(fields: [orgId], references: [id])
  plan                   Plan               @default(TRIAL)
  status                 SubscriptionStatus @default(TRIAL)
  billingCycle           BillingCycle       @default(MONTHLY)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  // 결제 게이트웨이 식별자 (별도 turn에서 채움)
  externalCustomerId     String?
  externalSubscriptionId String?
  updatedAt              DateTime           @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Invoice {
  id                String        @id @default(cuid())
  orgId             String
  org               Organization  @relation(fields: [orgId], references: [id])
  amount            Int // 원 단위 (KRW)
  currency          String        @default("KRW")
  status            InvoiceStatus @default(DRAFT)
  periodStart       DateTime
  periodEnd         DateTime
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?
  externalInvoiceId String?

  @@index([orgId, issuedAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}
