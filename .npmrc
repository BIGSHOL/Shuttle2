# Expo + pnpm monorepo: metro가 transitive RN/Expo 모듈을 root node_modules에서
# 찾을 수 있도록 hoist (node-linker=isolated 환경 호환).
# https://docs.expo.dev/guides/monorepos/#cant-resolve-package
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@babel/runtime
# pnpm 기본 hoist 유지 (eslint·prettier·types)
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*
