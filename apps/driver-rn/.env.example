# Expo는 EXPO_PUBLIC_* 환경변수만 클라이언트 번들에 포함 (Next.js의 NEXT_PUBLIC_* 동일 개념).
# 실제 값은 .env 파일에 작성. .env는 .gitignore에 의해 제외됨 → 로컬 dev 전용.
#
# EAS 클라우드 빌드(preview/production)는 .env를 못 보므로 eas.json의 `env` 블록이 metro 번들에 인라인.
# 즉 이 .env 파일은 `pnpm --filter driver-rn start`(metro dev) 시 사용, 정식 APK는 eas.json env 우선.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 API base URL.
# - 로컬 dev: 안드로이드 에뮬레이터는 호스트 PC를 10.0.2.2로 접근 (예: http://10.0.2.2:3000).
# - 실기기 dev: PC와 같은 Wi-Fi + PC IP (예: http://192.168.0.10:3000).
# - 프로덕션: 정식 도메인 발급 전까지는 Vercel 자동 도메인 https://shuttle2-nine.vercel.app
EXPO_PUBLIC_API_BASE_URL=https://shuttle2-nine.vercel.app
