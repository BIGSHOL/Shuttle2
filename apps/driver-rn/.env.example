# Expo는 EXPO_PUBLIC_* 환경변수만 클라이언트 번들에 포함 (Next.js의 NEXT_PUBLIC_* 동일 개념).
# 실제 값은 .env 파일에 작성. .env는 .gitignore에 의해 제외됨.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 API base URL — 로컬 dev 시 PC IP, 프로덕션 시 https://shuttlee.kr 등.
# 안드로이드 에뮬레이터: 호스트 PC를 10.0.2.2로 접근 (예: http://10.0.2.2:3000).
# 실기기 dev: PC와 같은 Wi-Fi + PC IP (예: http://192.168.0.10:3000).
EXPO_PUBLIC_API_BASE_URL=https://shuttlee.kr
